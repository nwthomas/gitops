kubeconfig_path = "/etc/rancher/k3s/k3s.yaml"

environment  = "dev"
cluster_name = "k3s-cluster"

managed_by = "terraform"

longhorn_replicas              = 3
longhorn_ha_replicas          = 6
longhorn_fast_replicas        = 2
longhorn_stale_replica_timeout = 2880
longhorn_fs_type              = "ext4"
